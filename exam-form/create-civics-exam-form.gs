// תמונת כותרת בעיצוב קציר (JPEG, base64)
var HEADER_B64 = '';

function createExamForm() {
  var form = FormApp.create(EXAM.title);
  form.setTitle(EXAM.title)
      .setDescription(EXAM.description)
      .setCollectEmail(false)
      .setLimitOneResponsePerUser(false)   // לא נועל לחשבון גוגל
      .setAllowResponseEdits(false)
      .setShowLinkToRespondAgain(false)
      .setProgressBar(true)
      .setConfirmationMessage('המבחן הוגש בהצלחה. בהצלחה!');
  try { form.setRequireLogin(false); } catch (e) { /* קיים רק בחשבונות Workspace */ }

  // תמונת כותרת בעיצוב קציר
  var header = Utilities.newBlob(Utilities.base64Decode(HEADER_B64), 'image/jpeg', 'katzir-header.jpg');
  form.addImageItem().setImage(header).setAlignment(FormApp.Alignment.CENTER);

  // פרטי התלמיד/ה (לא חובה, לפי בקשה)
  form.addTextItem().setTitle('שם תלמיד/ה').setRequired(false);
  form.addTextItem().setTitle('כיתה').setRequired(false);

  EXAM.chapters.forEach(function (ch) {
    form.addPageBreakItem().setTitle(ch.title).setHelpText(ch.desc);
    ch.questions.forEach(function (q) {
      var sec = form.addSectionHeaderItem().setTitle('שאלה ' + q.n);
      if (q.text) sec.setHelpText(q.text);
      q.parts.forEach(function (p) {
        form.addParagraphTextItem().setTitle(p).setRequired(false);
      });
    });
  });

  // גיליון תשובות מקושר
  var ss = SpreadsheetApp.create(EXAM.title + ' (תשובות)');
  form.setDestination(FormApp.DestinationType.SPREADSHEET, ss.getId());

  Logger.log('עריכת הטופס: ' + form.getEditUrl());
  Logger.log('קישור לתלמידים: ' + form.getPublishedUrl());
  Logger.log('גיליון התשובות: ' + ss.getUrl());
}
